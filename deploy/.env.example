# 배포 서버용 환경변수. deploy/.env 로 복사해 값을 채운다 (git 제외)
# deploy.sh 가 최초 1회 /opt/yongyong-model/.env 로 올린다
COLLECTOR_BASE_URL=http://<수집서버주소>:8080
DATA_FROM=2026-10-28
DATA_DIR=data
MODEL_DIR=models
# 서비스 DB: 같은 VM, 백엔드 deploy/.env 와 같은 계정
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=yongyong
MYSQL_USER=yongyong
MYSQL_PASSWORD=
